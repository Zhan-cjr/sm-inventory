{
  "name": "desktop-admin",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Aplikasi Desktop Admin SM Inventory (Kompatibel Windows 7/8/10/11)",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w",
    "build:win64": "electron-builder --win --x64",
    "build:win32": "electron-builder --win --ia32"
  },
  "author": {
    "name": "ZhanSoft - Amnal"
  },
  "build": {
    "appId": "com.sminventory.admin",
    "productName": "SM Inventory Admin",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "build_dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SM Inventory Admin"
    }
  },
  "keywords": [
    "admin",
    "electron",
    "windows7",
    "inventory"
  ],
  "license": "ISC",
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  }
}