{
  "name": "desktop-pos",
  "version": "2.3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w",
    "build:linux": "electron-builder --linux"
  },
  "homepage": "https://poskasir.toserbaselamat.id",
  "author": {
    "name": "Amnal",
    "email": "admin@toserbaselamat.id"
  },
  "build": {
    "appId": "com.amnal.poskasir",
    "productName": "POS SM Inventory",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "build_dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Utility",
      "maintainer": "Amnal <admin@toserbaselamat.id>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "Amnal",
  "license": "ISC",
  "description": "Aplikasi Desktop untuk POS Kasir",
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  }
}