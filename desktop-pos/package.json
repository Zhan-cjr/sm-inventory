{
  "name": "desktop-pos",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w"
  },
  "build": {
    "appId": "com.amnal.poskasir",
    "productName": "POS Kasir Desktop",
    "directories": {
      "output": "build_dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "Amnal",
  "license": "ISC",
  "description": "Aplikasi Desktop untuk POS Kasir",
  "devDependencies": {
    "electron": "~22.3.27",
    "electron-builder": "^24.13.3"
  }
}
